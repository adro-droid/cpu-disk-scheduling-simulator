/*
 * Shortest Remaining Time First (SRTF) Scheduling
 * (the preemptive version of Shortest Job First)
 * Owner: Montoya, Robin Gabriel
 * Course: ICS26012 - Operating Systems
 *
 * Rules used by this simulator:
 *  - The scheduler makes a decision at time 0, whenever a process arrives,
 *    and whenever a process completes.
 *  - At each decision, the CPU goes to the arrived process with the least
 *    remaining burst time.
 *  - Ties are broken by earlier arrival time, then by lower process number.
 *    Because of this, a newly arrived process preempts the running process
 *    only if its burst time is strictly shorter than the running process's
 *    remaining time.
 *  - If no process has arrived yet, the CPU stays idle until the next arrival.
 
 * Formulas:
 *  TAT = CT - AT,   WT = TAT - BT,   RT = (first time on CPU) - AT
 
 * Runs on its own (java SRTF) or as a screen in SchedulingSimulator.
 */
import javax.swing.*;
import javax.swing.table.DefaultTableModel;
import java.awt.*;
import java.util.ArrayList;
import java.util.Comparator;
import java.util.HashMap;
import java.util.List;

public class SRTF extends JPanel {

    static final int MAX_PROCESSES = 20;
    static final long MAX_INPUT = 1000000;

    private final ArrayList<SRTFProcess> processes = new ArrayList<>();

    private final DefaultTableModel processModel = readOnlyModel(
        "PID", "Arrival Time", "Burst Time"
    );

    private final DefaultTableModel resultModel = readOnlyModel(
        "PID", "AT", "BT", "CT", "TAT", "WT", "RT"
    );

    private final DefaultTableModel logModel = readOnlyModel(
        "Time", "Event", "Ready Processes (remaining time)", "CPU Decision"
    );

    private final JTextField pidField = new JTextField(6);
    private final JTextField arrivalField = new JTextField(6);
    private final JTextField burstField = new JTextField(6);

    private final JLabel averageWTLabel = new JLabel();
    private final JLabel averageTATLabel = new JLabel();
    private final JLabel averageRTLabel = new JLabel();
    private final JLabel utilizationLabel = new JLabel();
    private final JLabel throughputLabel = new JLabel();
    private final JLabel preemptionLabel = new JLabel();

    private final SRTFGanttChartPanel ganttChart = new SRTFGanttChartPanel();
    private final JTabbedPane tabs = new JTabbedPane();

    public static void main(String[] args) {

        SwingUtilities.invokeLater(() -> {

            JFrame frame = new JFrame(
                "Shortest Remaining Time First (SRTF) Scheduling"
            );

            frame.setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
            frame.setContentPane(new SRTF());
            frame.setSize(1100, 720);
            frame.setMinimumSize(new Dimension(850, 620));
            frame.setLocationRelativeTo(null);
            frame.setVisible(true);
        });
    }

    public SRTF() {

        super(new BorderLayout(10, 10));

        setBackground(new Color(238, 240, 243));
        setBorder(BorderFactory.createEmptyBorder(15, 18, 15, 18));

        add(buildTopPanel(), BorderLayout.NORTH);
        add(buildTabs(), BorderLayout.CENTER);
        add(buildMetricsPanel(), BorderLayout.SOUTH);

        resetResults();
    }

    // ------------------------------------------------------------------
    // Screen layout
    // ------------------------------------------------------------------

    private JPanel buildTopPanel() {

        JLabel title = new JLabel(
            "SHORTEST REMAINING TIME FIRST (SRTF) SCHEDULING"
        );

        title.setFont(new Font("Arial", Font.BOLD, 22));
        title.setForeground(new Color(35, 45, 60));
        title.setHorizontalAlignment(SwingConstants.CENTER);

        JPanel inputRow = new JPanel(
            new FlowLayout(FlowLayout.CENTER, 8, 5)
        );

        inputRow.setBackground(Color.WHITE);

        inputRow.add(new JLabel("Process ID:"));
        inputRow.add(pidField);

        inputRow.add(new JLabel("Arrival Time:"));
        inputRow.add(arrivalField);

        inputRow.add(new JLabel("Burst Time:"));
        inputRow.add(burstField);

        JButton addButton = new JButton("Add Process");
        JButton runButton = new JButton("Run Scheduling");
        JButton sampleButton = new JButton("Load Sample Data");
        JButton clearButton = new JButton("Clear All");

        addButton.addActionListener(e -> addProcess());
        runButton.addActionListener(e -> runScheduling());
        sampleButton.addActionListener(e -> loadSampleData());
        clearButton.addActionListener(e -> clearAll());

        // Pressing Enter in the last field also adds the process.
        burstField.addActionListener(e -> addProcess());

        JPanel buttonRow = new JPanel(
            new FlowLayout(FlowLayout.CENTER, 10, 5)
        );

        buttonRow.setBackground(Color.WHITE);
        buttonRow.add(addButton);
        buttonRow.add(runButton);
        buttonRow.add(sampleButton);
        buttonRow.add(clearButton);

        JPanel inputPanel = new JPanel(new GridLayout(2, 1, 5, 5));

        inputPanel.setBackground(Color.WHITE);
        inputPanel.setBorder(BorderFactory.createEmptyBorder(5, 5, 5, 5));
        inputPanel.add(inputRow);
        inputPanel.add(buttonRow);

        JPanel topPanel = new JPanel(new BorderLayout(8, 12));

        topPanel.setOpaque(false);
        topPanel.add(title, BorderLayout.NORTH);
        topPanel.add(inputPanel, BorderLayout.CENTER);

        return topPanel;
    }

    private JTabbedPane buildTabs() {

        tabs.addTab("Processes", new JScrollPane(makeTable(processModel)));

        tabs.addTab(
            "Scheduling Results",
            new JScrollPane(makeTable(resultModel))
        );

        JScrollPane chartScroll = new JScrollPane(ganttChart);

        chartScroll.setHorizontalScrollBarPolicy(
            ScrollPaneConstants.HORIZONTAL_SCROLLBAR_AS_NEEDED
        );

        chartScroll.setVerticalScrollBarPolicy(
            ScrollPaneConstants.VERTICAL_SCROLLBAR_AS_NEEDED
        );

        tabs.addTab("Gantt Chart", chartScroll);

        // The step log shows every decision the scheduler made, so a
        // hand-solved answer can be checked line by line.
        JTable logTable = makeTable(logModel);

        logTable.getColumnModel().getColumn(0).setPreferredWidth(60);
        logTable.getColumnModel().getColumn(1).setPreferredWidth(200);
        logTable.getColumnModel().getColumn(2).setPreferredWidth(380);
        logTable.getColumnModel().getColumn(3).setPreferredWidth(200);

        tabs.addTab("Step Log", new JScrollPane(logTable));

        return tabs;
    }

    private JPanel buildMetricsPanel() {

        JPanel metricsPanel = new JPanel(new GridLayout(2, 3, 10, 5));

        metricsPanel.setBackground(Color.WHITE);
        metricsPanel.setBorder(
            BorderFactory.createEmptyBorder(10, 12, 10, 12)
        );

        metricsPanel.add(averageWTLabel);
        metricsPanel.add(averageTATLabel);
        metricsPanel.add(averageRTLabel);
        metricsPanel.add(utilizationLabel);
        metricsPanel.add(throughputLabel);
        metricsPanel.add(preemptionLabel);

        return metricsPanel;
    }

    private static DefaultTableModel readOnlyModel(String... columns) {

        return new DefaultTableModel(columns, 0) {
            @Override
            public boolean isCellEditable(int row, int column) {
                return false;
            }
        };
    }

    private static JTable makeTable(DefaultTableModel model) {

        JTable table = new JTable(model);

        table.setRowHeight(25);
        table.setFont(new Font("Arial", Font.PLAIN, 13));
        table.getTableHeader().setFont(new Font("Arial", Font.BOLD, 13));

        return table;
    }

    // ------------------------------------------------------------------
    // Button actions
    // ------------------------------------------------------------------

    private void addProcess() {

        if (processes.size() >= MAX_PROCESSES) {
            showError("Maximum of 20 processes allowed.");
            return;
        }

        String id = pidField.getText().trim().toUpperCase();

        if (!id.matches("P[1-9][0-9]*")) {
            showError("Enter a valid Process ID (example: P1).");
            return;
        }

        long processNumber;
        long arrival;
        long burst;

        try {

            processNumber = Long.parseLong(id.substring(1));
            arrival = Long.parseLong(arrivalField.getText().trim());
            burst = Long.parseLong(burstField.getText().trim());

        } catch (NumberFormatException ex) {

            showError("Please enter valid whole numbers.");
            return;
        }

        for (SRTFProcess p : processes) {

            if (p.processNumber == processNumber) {
                showError("Process ID already exists.");
                return;
            }
        }

        if (arrival < 0 || burst <= 0) {

            showError(
                "Arrival time must be non-negative. "
                + "Burst time must be positive."
            );

            return;
        }

        if (arrival > MAX_INPUT || burst > MAX_INPUT
                || processNumber > MAX_INPUT) {

            showError("Input values must not exceed 1,000,000.");
            return;
        }

        processes.add(
            new SRTFProcess((int) processNumber, id, arrival, burst)
        );

        processModel.addRow(new Object[]{id, arrival, burst});

        resetResults();
        clearFields();
    }

    private void runScheduling() {

        if (processes.isEmpty()) {
            showError("Please add at least one process.");
            return;
        }

        SRTFScheduler.ScheduleResult result =
            new SRTFScheduler().schedule(processes);

        // Display processes in numerical PID order.
        ArrayList<SRTFProcess> sorted = new ArrayList<>(processes);
        sorted.sort(Comparator.comparingInt(p -> p.processNumber));

        resultModel.setRowCount(0);

        for (SRTFProcess p : sorted) {

            resultModel.addRow(new Object[]{
                p.id,
                p.arrivalTime,
                p.burstTime,
                p.completionTime,
                p.turnaroundTime,
                p.waitingTime,
                p.responseTime
            });
        }

        logModel.setRowCount(0);

        for (SRTFScheduler.LogEntry entry : result.log) {

            logModel.addRow(new Object[]{
                entry.time, entry.event, entry.readyQueue, entry.decision
            });
        }

        averageWTLabel.setText(String.format(
            "Average WT: %.2f ms", result.averageWaitingTime
        ));

        averageTATLabel.setText(String.format(
            "Average TAT: %.2f ms", result.averageTurnaroundTime
        ));

        averageRTLabel.setText(String.format(
            "Average RT: %.2f ms", result.averageResponseTime
        ));

        utilizationLabel.setText(String.format(
            "CPU Utilization: %.2f%%", result.cpuUtilization
        ));

        throughputLabel.setText(String.format(
            "Throughput: %.4f processes/ms", result.throughput
        ));

        preemptionLabel.setText("Preemptions: " + result.preemptions);

        ArrayList<String> ids = new ArrayList<>();

        for (SRTFProcess p : sorted) {
            ids.add(p.id);
        }

        ganttChart.setSegments(result.segments, result.totalTime, ids);

        tabs.setSelectedIndex(2);
    }

    private void loadSampleData() {

        processes.clear();
        processModel.setRowCount(0);
        resetResults();

        // P1-P4 are the classic textbook SRTF example (average WT = 6.5).
        // P5 and P6 add an idle gap and one more preemption.
        addSample("P1", 0, 8);
        addSample("P2", 1, 4);
        addSample("P3", 2, 9);
        addSample("P4", 3, 5);
        addSample("P5", 30, 3);
        addSample("P6", 31, 1);
    }

    private void addSample(String id, long arrival, long burst) {

        int number = Integer.parseInt(id.substring(1));

        processes.add(new SRTFProcess(number, id, arrival, burst));
        processModel.addRow(new Object[]{id, arrival, burst});
    }

    private void clearAll() {

        processes.clear();
        processModel.setRowCount(0);

        resetResults();
        clearFields();
    }

    private void clearFields() {

        pidField.setText("");
        arrivalField.setText("");
        burstField.setText("");

        pidField.requestFocus();
    }

    private void resetResults() {

        resultModel.setRowCount(0);
        logModel.setRowCount(0);

        ganttChart.clear();

        averageWTLabel.setText("Average WT: -");
        averageTATLabel.setText("Average TAT: -");
        averageRTLabel.setText("Average RT: -");
        utilizationLabel.setText("CPU Utilization: -");
        throughputLabel.setText("Throughput: -");
        preemptionLabel.setText("Preemptions: -");
    }

    private void showError(String message) {

        JOptionPane.showMessageDialog(
            this, message, "Input Error", JOptionPane.ERROR_MESSAGE
        );
    }
}


class SRTFProcess {

    int processNumber;
    String id;

    long arrivalTime;
    long burstTime;

    // Changes while the simulation runs.
    long remainingTime;
    boolean started;

    long startTime;
    long completionTime;
    long turnaroundTime;
    long waitingTime;
    long responseTime;

    SRTFProcess(int processNumber, String id, long arrivalTime, long burstTime) {

        this.processNumber = processNumber;
        this.id = id;
        this.arrivalTime = arrivalTime;
        this.burstTime = burstTime;

        reset();
    }

    // Clears results so the same process list can be scheduled again.
    void reset() {

        remainingTime = burstTime;
        started = false;

        startTime = 0;
        completionTime = 0;
        turnaroundTime = 0;
        waitingTime = 0;
        responseTime = 0;
    }
}


class SRTFScheduler {

    static class Segment {

        String processID;
        long start;
        long end;

        Segment(String processID, long start, long end) {

            this.processID = processID;
            this.start = start;
            this.end = end;
        }
    }

    // One row of the step log: what happened at a decision point.
    static class LogEntry {

        long time;
        String event;
        String readyQueue;
        String decision;

        LogEntry(long time, String event, String readyQueue, String decision) {

            this.time = time;
            this.event = event;
            this.readyQueue = readyQueue;
            this.decision = decision;
        }
    }

    static class ScheduleResult {

        ArrayList<Segment> segments = new ArrayList<>();
        ArrayList<LogEntry> log = new ArrayList<>();

        double averageWaitingTime;
        double averageTurnaroundTime;
        double averageResponseTime;

        double cpuUtilization;
        double throughput;

        long totalTime;
        int preemptions;
    }

    // Least remaining time first; ties go to the earlier arrival,
    // then to the lower process number.
    private static final Comparator<SRTFProcess> SHORTEST_REMAINING_FIRST =
        Comparator.comparingLong((SRTFProcess p) -> p.remainingTime)
            .thenComparingLong(p -> p.arrivalTime)
            .thenComparingInt(p -> p.processNumber);

    public ScheduleResult schedule(ArrayList<SRTFProcess> processes) {

        ScheduleResult result = new ScheduleResult();

        for (SRTFProcess p : processes) {
            p.reset();
        }

        int count = processes.size();
        int finished = 0;

        long currentTime = 0;
        long busyTime = 0;

        double totalWaitingTime = 0;
        double totalTurnaroundTime = 0;
        double totalResponseTime = 0;

        // The process that was on the CPU just before currentTime and is
        // not finished yet (null if the CPU was idle or a process just ended).
        SRTFProcess running = null;

        // The process that completed exactly at currentTime (for the log).
        SRTFProcess justFinished = null;

        while (finished < count) {

            ArrayList<SRTFProcess> ready = readyProcesses(processes, currentTime);
            String event = describeEvent(processes, currentTime, justFinished);

            // Nobody has arrived yet: the CPU waits for the next arrival.
            if (ready.isEmpty()) {

                long nextArrival = nextArrivalAfter(processes, currentTime);

                addSegment(result, "IDLE", currentTime, nextArrival);

                result.log.add(new LogEntry(
                    currentTime, event, "-", "CPU idle until " + nextArrival
                ));

                currentTime = nextArrival;
                running = null;
                justFinished = null;
                continue;
            }

            ready.sort(SHORTEST_REMAINING_FIRST);
            SRTFProcess selected = ready.get(0);

            String decision;

            if (running == null) {
                decision = "Run " + selected.id;
            } else if (running == selected) {
                decision = selected.id + " continues";
            } else {
                decision = selected.id + " preempts " + running.id;
                result.preemptions++;
            }

            result.log.add(new LogEntry(
                currentTime, event, describeQueue(ready), decision
            ));

            // Response time is measured the first time a process gets the CPU.
            if (!selected.started) {

                selected.started = true;
                selected.startTime = currentTime;
                selected.responseTime = currentTime - selected.arrivalTime;
            }

            // Run the selected process until it finishes or until the next
            // process arrives, whichever comes first. Nothing can change the
            // decision between those two moments.
            long runUntil = currentTime + selected.remainingTime;
            long nextArrival = nextArrivalAfter(processes, currentTime);

            if (nextArrival < runUntil) {
                runUntil = nextArrival;
            }

            addSegment(result, selected.id, currentTime, runUntil);

            selected.remainingTime -= runUntil - currentTime;
            busyTime += runUntil - currentTime;
            currentTime = runUntil;

            if (selected.remainingTime == 0) {

                selected.completionTime = currentTime;
                selected.turnaroundTime =
                    selected.completionTime - selected.arrivalTime;
                selected.waitingTime =
                    selected.turnaroundTime - selected.burstTime;

                totalWaitingTime += selected.waitingTime;
                totalTurnaroundTime += selected.turnaroundTime;
                totalResponseTime += selected.responseTime;

                finished++;
                running = null;
                justFinished = selected;

            } else {

                running = selected;
                justFinished = null;
            }
        }

        result.log.add(new LogEntry(
            currentTime,
            justFinished.id + " completes",
            "-",
            "All processes finished"
        ));

        result.totalTime = currentTime;

        result.averageWaitingTime = totalWaitingTime / count;
        result.averageTurnaroundTime = totalTurnaroundTime / count;
        result.averageResponseTime = totalResponseTime / count;

        result.cpuUtilization = (double) busyTime / result.totalTime * 100;
        result.throughput = (double) count / result.totalTime;

        return result;
    }

    // Processes that have arrived and still need CPU time.
    private static ArrayList<SRTFProcess> readyProcesses(
        ArrayList<SRTFProcess> processes, long time
    ) {

        ArrayList<SRTFProcess> ready = new ArrayList<>();

        for (SRTFProcess p : processes) {

            if (p.arrivalTime <= time && p.remainingTime > 0) {
                ready.add(p);
            }
        }

        return ready;
    }

    // Earliest arrival strictly after the given time (Long.MAX_VALUE if none).
    private static long nextArrivalAfter(
        ArrayList<SRTFProcess> processes, long time
    ) {

        long next = Long.MAX_VALUE;

        for (SRTFProcess p : processes) {

            if (p.arrivalTime > time && p.arrivalTime < next) {
                next = p.arrivalTime;
            }
        }

        return next;
    }

    // Adds a Gantt chart block, joining it to the previous block when the
    // same process simply keeps running.
    private static void addSegment(
        ScheduleResult result, String id, long start, long end
    ) {

        if (!result.segments.isEmpty()) {

            Segment last = result.segments.get(result.segments.size() - 1);

            if (last.processID.equals(id) && last.end == start) {
                last.end = end;
                return;
            }
        }

        result.segments.add(new Segment(id, start, end));
    }

    // Text for the "Event" column, e.g. "P2 completes, P4 arrives".
    private static String describeEvent(
        ArrayList<SRTFProcess> processes, long time, SRTFProcess justFinished
    ) {

        ArrayList<String> parts = new ArrayList<>();

        if (justFinished != null) {
            parts.add(justFinished.id + " completes");
        }

        ArrayList<SRTFProcess> arrivals = new ArrayList<>();

        for (SRTFProcess p : processes) {

            if (p.arrivalTime == time) {
                arrivals.add(p);
            }
        }

        arrivals.sort(Comparator.comparingInt(p -> p.processNumber));

        for (SRTFProcess p : arrivals) {
            parts.add(p.id + " arrives");
        }

        if (parts.isEmpty()) {
            return "Start";
        }

        return String.join(", ", parts);
    }

    // Text for the ready-queue column, e.g. "P2 (4), P1 (7)".
    private static String describeQueue(List<SRTFProcess> ready) {

        ArrayList<String> parts = new ArrayList<>();

        for (SRTFProcess p : ready) {
            parts.add(p.id + " (" + p.remainingTime + ")");
        }

        return String.join(", ", parts);
    }
}


class SRTFGanttChartPanel extends JPanel implements Scrollable {

    private static final int LEFT = 30;
    private static final int RIGHT = 30;
    private static final int TOP = 65;
    private static final int BLOCK_HEIGHT = 55;
    private static final int MIN_BLOCK_WIDTH = 40;
    private static final int CHART_HEIGHT = 215;

    private static final Color IDLE_COLOR = new Color(205, 210, 218);

    private ArrayList<SRTFScheduler.Segment> segments = new ArrayList<>();
    private long totalTime;

    private final HashMap<String, Color> colors = new HashMap<>();

    SRTFGanttChartPanel() {
        setBackground(Color.WHITE);
    }

    void setSegments(
        ArrayList<SRTFScheduler.Segment> newSegments,
        long newTotalTime,
        List<String> processIds
    ) {

        segments = new ArrayList<>(newSegments);
        totalTime = newTotalTime;

        // Give each process its own soft colour so that a process that was
        // preempted is easy to follow across the chart.
        colors.clear();

        for (int i = 0; i < processIds.size(); i++) {

            float hue = (float) ((i * 0.618034) % 1.0);
            colors.put(processIds.get(i), Color.getHSBColor(hue, 0.35f, 0.95f));
        }

        revalidate();
        repaint();
    }

    void clear() {
        setSegments(new ArrayList<>(), 0, new ArrayList<>());
    }

    private int viewportWidth() {

        Container parent = getParent();

        if (parent instanceof JViewport) {
            return parent.getWidth();
        }

        return getWidth() > 0 ? getWidth() : 700;
    }

    // Set by blockEdges(): true if some block had to be drawn wider than
    // its share of time.
    private boolean widened;

    // x position of every block edge. Widths follow time, but a block is
    // never drawn narrower than MIN_BLOCK_WIDTH so its label stays readable.
    // Short blocks get MIN_BLOCK_WIDTH and the other blocks share the rest
    // of the width in proportion to their time. The chart only gets wider
    // than the window (and scrolls) when even that is not enough room.
    private double[] blockEdges() {

        int n = segments.size();
        double available = Math.max(300, viewportWidth() - LEFT - RIGHT);

        double[] widths = new double[n];
        boolean[] fixed = new boolean[n];
        boolean changed = true;

        while (changed) {

            changed = false;

            double freeWidth = available;
            long freeTime = 0;

            for (int i = 0; i < n; i++) {

                if (fixed[i]) {
                    freeWidth -= MIN_BLOCK_WIDTH;
                } else {
                    freeTime += segments.get(i).end - segments.get(i).start;
                }
            }

            for (int i = 0; i < n; i++) {

                if (fixed[i]) {
                    continue;
                }

                long duration = segments.get(i).end - segments.get(i).start;

                widths[i] = (freeTime > 0 && freeWidth > 0)
                    ? freeWidth * duration / freeTime
                    : 0;

                if (widths[i] < MIN_BLOCK_WIDTH) {
                    fixed[i] = true;
                    changed = true;
                }
            }
        }

        widened = false;

        double[] edges = new double[n + 1];
        edges[0] = LEFT;

        for (int i = 0; i < n; i++) {

            if (fixed[i]) {
                widths[i] = MIN_BLOCK_WIDTH;
                widened = true;
            }

            edges[i + 1] = edges[i] + widths[i];
        }

        return edges;
    }

    @Override
    public Dimension getPreferredSize() {

        if (segments.isEmpty() || totalTime <= 0) {
            return new Dimension(700, CHART_HEIGHT);
        }

        double[] edges = blockEdges();

        return new Dimension(
            (int) Math.ceil(edges[edges.length - 1]) + RIGHT, CHART_HEIGHT
        );
    }

    @Override
    protected void paintComponent(Graphics g) {

        super.paintComponent(g);

        if (segments.isEmpty() || totalTime <= 0) {

            g.setColor(Color.GRAY);
            g.drawString("Run scheduling to display the Gantt chart.", 25, 55);
            return;
        }

        Graphics2D g2 = (Graphics2D) g.create();

        g2.setRenderingHint(
            RenderingHints.KEY_ANTIALIASING,
            RenderingHints.VALUE_ANTIALIAS_ON
        );

        g2.setRenderingHint(
            RenderingHints.KEY_TEXT_ANTIALIASING,
            RenderingHints.VALUE_TEXT_ANTIALIAS_ON
        );

        g2.setFont(new Font("Arial", Font.BOLD, 13));
        g2.setColor(Color.DARK_GRAY);
        g2.drawString("Gantt Chart", LEFT, 30);

        double[] edges = blockEdges();
        FontMetrics fm = g2.getFontMetrics();

        // Blocks.
        for (int i = 0; i < segments.size(); i++) {

            SRTFScheduler.Segment segment = segments.get(i);

            int x1 = (int) Math.round(edges[i]);
            int x2 = (int) Math.round(edges[i + 1]);
            int width = x2 - x1;

            Color fill = segment.processID.equals("IDLE")
                ? IDLE_COLOR
                : colors.getOrDefault(segment.processID, new Color(100, 160, 220));

            g2.setColor(fill);
            g2.fillRect(x1, TOP, width, BLOCK_HEIGHT);

            g2.setColor(Color.DARK_GRAY);
            g2.drawRect(x1, TOP, width, BLOCK_HEIGHT);

            int textWidth = fm.stringWidth(segment.processID);

            if (width >= textWidth + 6) {

                g2.drawString(
                    segment.processID,
                    x1 + (width - textWidth) / 2,
                    TOP + (BLOCK_HEIGHT + fm.getAscent()) / 2 - 2
                );
            }
        }

        // Time labels under every block edge. When two labels would
        // overlap, the second one drops to a lower row.

        int labelY = TOP + BLOCK_HEIGHT + 20;
        int rowGap = 16;
        int[] rowRightEdge = {Integer.MIN_VALUE, Integer.MIN_VALUE};

        for (int i = 0; i < edges.length; i++) {

            long time = (i == 0) ? segments.get(0).start : segments.get(i - 1).end;

            int x = (int) Math.round(edges[i]);
            String label = String.valueOf(time);
            int labelWidth = fm.stringWidth(label);
            int labelX = x - labelWidth / 2;

            int row = (labelX > rowRightEdge[0] + 4) ? 0 : 1;
            rowRightEdge[row] = labelX + labelWidth;

            g2.setColor(Color.DARK_GRAY);
            g2.drawLine(
                x, TOP + BLOCK_HEIGHT,
                x, TOP + BLOCK_HEIGHT + 5 + row * rowGap
            );
            g2.drawString(label, labelX, labelY + row * rowGap);
        }

        if (widened) {

            g2.setFont(new Font("Arial", Font.ITALIC, 11));
            g2.setColor(Color.GRAY);
            g2.drawString(
                "Note: block widths follow time, except very short slices, "
                + "which are drawn wider so their labels stay readable. "
                + "The time labels are exact.",
                LEFT, labelY + rowGap + 26
            );
        }

        g2.dispose();
    }

    @Override
    public Dimension getPreferredScrollableViewportSize() {
        return new Dimension(700, CHART_HEIGHT);
    }

    @Override
    public int getScrollableUnitIncrement(
        Rectangle visibleRect, int orientation, int direction
    ) {
        return 20;
    }

    @Override
    public int getScrollableBlockIncrement(
        Rectangle visibleRect, int orientation, int direction
    ) {
        return 100;
    }

    // Fill the visible width unless the chart needs more room, in which
    // case a horizontal scroll bar appears.
    @Override
    public boolean getScrollableTracksViewportWidth() {

        Container parent = getParent();

        return parent instanceof JViewport
            && getPreferredSize().width <= parent.getWidth();
    }

    @Override
    public boolean getScrollableTracksViewportHeight() {

        Container parent = getParent();

        return parent instanceof JViewport
            && parent.getHeight() >= CHART_HEIGHT;
    }
}
